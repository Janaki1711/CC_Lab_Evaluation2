# ==============================================================================
# Environment Configuration Template
# Academic Document Submission & Intelligent Kubernetes Placement Platform
# ==============================================================================

# Global Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_DB=academic_docs_db
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=academic_secure_password_2026
POSTGRES_HOST=postgres-service
POSTGRES_PORT=5432

# MinIO Object Storage Configuration
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secure_password_2026
MINIO_ENDPOINT=minio-service:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_BUCKET_NAME=academic-documents
MINIO_USE_SSL=false

# Authentication & Security
JWT_SECRET_KEY=super_secret_jwt_signing_key_replace_in_production_2026!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Internal Service URLs (Kubernetes DNS / Docker Compose)
AUTH_SERVICE_URL=http://auth-service:8001
FILE_SERVICE_URL=http://file-service:8002
METADATA_SERVICE_URL=http://metadata-service:8003
API_GATEWAY_URL=http://api-gateway:80

# Prometheus Monitoring
PROMETHEUS_METRICS_ENABLED=true

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost/api
